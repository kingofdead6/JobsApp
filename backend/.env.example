PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/bahth_aan_amal_dz
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=30d

# النطاقات المسموح لها بالنداء (لوحة الإدارة). افصل بينها بفاصلة.
# التطبيق المحمول لا يحتاج CORS.
CLIENT_ORIGIN=http://localhost:5173

# التخزين السحابي — Cloudinary
# من لوحة التحكّم: https://console.cloudinary.com/settings/api-keys
# إن تُركت فارغة، تُخزَّن الملفات محليًا في uploads/ (للتطوير فقط،
# لا تصلح على Render لأن نظام ملفاته مؤقّت).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMS provider (Algerian). Left blank in dev: OTP codes are logged to the console.
SMS_PROVIDER_KEY=
